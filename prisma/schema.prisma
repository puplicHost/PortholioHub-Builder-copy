// Prisma schema for MarketOS — PostgreSQL backend (migration from Supabase).
// Field names are camelCase; @map() targets the original snake_case columns.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String?   @map("password_hash")
  displayName   String?   @map("display_name")
  avatarUrl     String?   @map("avatar_url")
  isAdmin       Boolean   @default(false) @map("is_admin")
  emailVerified Boolean   @default(false) @map("email_verified")
  status        String    @default("ACTIVE")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  metadata      Json?

  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  profile                   Profile?
  portfolioProfile          UserProfile?
  ownedWorkspaces           Workspace[]          @relation("WorkspaceOwner")
  memberships               WorkspaceMember[]
  subscriptions             Subscription[]
  subscriptionRequests      SubscriptionRequest[]
  payments                  Payment[]
  fcmTokens                 FcmToken[]
  notifications             Notification[]
  adminAuditLogs            AdminAuditLog[]      @relation("AdminAuditAdmin")
  adminAuditTargets         AdminAuditLog[]      @relation("AdminAuditTarget")
  adminUserNotesAdmin       AdminUserNote[]      @relation("AdminNoteAdmin")
  adminUserNotesOwner       AdminUserNote[]      @relation("AdminNoteOwner")
  referralOwner             Referral[]           @relation("ReferralOwner")
  referralReferrer          Referral[]           @relation("ReferralReferrer")
  strategyComments          StrategyComment[]
  contentComments           ContentComment[]
  mediaFiles                MediaFile[]

  @@map("users")
}

model Profile {
  userId      String   @id @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  isAdmin     Boolean  @default(false) @map("is_admin")
  bio         String?
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  remember   Boolean  @default(false)
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime? @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@map("rate_limit_buckets")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

// ============================================================
// WORKSPACES
// ============================================================

model Workspace {
  id           String    @id @default(uuid())
  name         String
  ownerId      String    @map("owner_id")
  owner        User      @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  logoUrl      String?   @map("logo_url")
  description  String?   @map("description")
  themeColor   String?   @map("theme_color")
  settings     Json
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  suspendedAt  DateTime? @map("suspended_at")
  archivedAt   DateTime? @map("archived_at")

  members           WorkspaceMember[]
  content           Content[]
  contentItems      ContentItem[]
  strategies        Strategy[]
  planningDocuments PlanningDocument[]
  calendarEvents    CalendarEvent[]
  media             Media[]
  swotCards         SwotCard[]
  tasks             Task[]
  campaigns         Campaign[]
  sharedLinks       SharedLink[]
  strategyTemplates StrategyTemplate[]
  planningItems     PlanningItem[]
  subscriptions     Subscription[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?   @map("user_id")
  user        User?     @relation(fields: [userId], references: [id])
  email       String?   @map("email")
  role        String
  invitedBy   String?   @map("invited_by")
  inviteToken String?   @unique @map("invite_token")
  invitedAt   DateTime  @default(now()) @map("invited_at")
  acceptedAt  DateTime? @map("accepted_at")

  @@unique([workspaceId, userId])
  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

// ============================================================
// CONTENT
// ============================================================

model Content {
  id                   String    @id @default(uuid())
  workspaceId          String    @map("workspace_id")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title                String
  caption              String
  platform             String
  platforms            Json
  status               String
  campaignId           String?   @map("campaign_id")
  mediaUrls            String[]  @map("media_urls")
  scheduledAt          DateTime? @map("scheduled_at")
  plannedAt            DateTime? @map("planned_at")
  publishedAt          DateTime? @map("published_at")
  assignedTo           String?   @map("assigned_to")
  reviewerId           String?   @map("reviewer_id")
  reviewNotes          String?   @map("review_notes")
  submittedForReviewAt DateTime? @map("submitted_for_review_at")
  approvedBy           String?   @map("approved_by")
  approvedAt           DateTime? @map("approved_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  shares      ContentShare[]
  comments    ContentComment[]
  versions    ContentVersion[]

  @@index([workspaceId])
  @@map("content")
}

model ContentShare {
  id         String   @id @default(uuid())
  contentId  String   @map("content_id")
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  publicId   String   @map("public_id")
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by")
  revokedAt  DateTime? @map("revoked_at")

  @@unique([contentId, publicId])
  @@index([contentId])
  @@map("content_shares")
}

model ContentComment {
  id         String   @id @default(uuid())
  contentId  String   @map("content_id")
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String?  @map("parent_id")
  text       String
  selection  Json?
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([contentId])
  @@map("content_comments")
}

model ContentVersion {
  id        String   @id @default(uuid())
  contentId String   @map("content_id")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version   Int
  title     String
  body      Json?
  status    String
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@unique([contentId, version])
  @@index([contentId])
  @@map("content_versions")
}

// ============================================================
// STRATEGY
// ============================================================

model Strategy {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title            String
  brandName        String    @map("brand_name")
  industry         String
  description      String
  website          String
  logoUrl          String?   @map("logo_url")
  goals            Json
  audience         Json
  brandVoice       Json      @map("brand_voice")
  contentPillars   Json      @map("content_pillars")
  content          Json?
  status           String
  tags             String[]
  emoji            String
  coverUrl         String?   @map("cover_url")
  isComplete       Boolean   @map("is_complete")
  createdBy        String?   @map("created_by")
  createdByName    String    @map("created_by_name")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  publishedAt      DateTime? @map("published_at")
  archivedAt       DateTime? @map("archived_at")
  campaign         String
  objective        String
  targetAudience   String    @map("target_audience")
  primaryPersona   String    @map("primary_persona")
  painPoints       String    @map("pain_points")
  goalsText        String    @map("goals_text")
  kpis             String
  duration         String
  competitors      String[]
  channels         String[]
  publishingFrequency String @map("publishing_frequency")
  toneOfVoice      String    @map("tone_of_voice")
  brandPersonality String    @map("brand_personality")
  writingStyle     String    @map("writing_style")
  ctaStyle         String    @map("cta_style")
  language         String
  collaborators    String[]

  shares   StrategyShare[]
  comments StrategyComment[]
  versions StrategyVersion[]

  @@index([workspaceId])
  @@map("strategy")
}

model StrategyTemplate {
  id          String     @id @default(uuid())
  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  category    String
  emoji       String
  description String
  content     Json?
  metadata    Json
  isFavorite  Boolean    @map("is_favorite")
  isSystem    Boolean    @map("is_system")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("strategy_templates")
}

model StrategyShare {
  id         String   @id @default(uuid())
  strategyId String   @map("strategy_id")
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  publicId   String   @map("public_id")
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by")
  revokedAt  DateTime? @map("revoked_at")

  @@unique([strategyId, publicId])
  @@index([strategyId])
  @@map("strategy_shares")
}

model StrategyComment {
  id         String   @id @default(uuid())
  strategyId String   @map("strategy_id")
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String?  @map("parent_id")
  text       String
  selection  Json?
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([strategyId])
  @@map("strategy_comments")
}

model StrategyVersion {
  id         String    @id @default(uuid())
  strategyId String    @map("strategy_id")
  strategy   Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  version    Int
  title      String
  content    Json?
  status     String
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")

  @@unique([strategyId, version])
  @@index([strategyId])
  @@map("strategy_versions")
}

// ============================================================
// CONTENT LIBRARY
// ============================================================

model ContentItem {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  type        String
  description String?
  status      String    @default("draft")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, type])
  @@map("content_items")
}

// ============================================================
// PLANNING
// ============================================================

model PlanningDocument {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  brand       String
  month       Int?      @map("month")
  year        Int?      @map("year")
  description String
  color       String
  template    String
  status      String
  ownerName   String    @map("owner_name")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  items  PlanningItem[]
  shares PlanningShare[]

  @@index([workspaceId])
  @@map("planning_documents")
}

model PlanningItem {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId    String    @map("document_id")
  document      PlanningDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  week          String
  plannedDate   DateTime? @map("planned_date")
  platform      String
  contentType   String    @map("content_type")
  topic         String
  goal          String
  contentPillar String    @map("content_pillar")
  campaign      String?
  cta           String?
  status        String
  notes         String?
  contentId     String?   @map("content_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([workspaceId])
  @@index([documentId])
  @@map("planning_items")
}

model PlanningShare {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  document   PlanningDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  publicId   String   @map("public_id")
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by")
  revokedAt  DateTime? @map("revoked_at")

  @@unique([documentId, publicId])
  @@index([documentId])
  @@map("planning_shares")
}

// ============================================================
// CALENDAR / SWOT / TASKS / CAMPAIGNS
// ============================================================

model CalendarEvent {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventType    String    @map("event_type")
  title        String
  description  String?
  startAt      DateTime  @map("start_at")
  endAt        DateTime? @map("end_at")
  allDay       Boolean   @default(false) @map("all_day")
  location     String?
  color        String?
  status       String    @default("confirmed")
  isRecurring  Boolean   @default(false) @map("is_recurring")
  recurrence   Json?
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([workspaceId])
  @@map("calendar_events")
}

model SwotCard {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String
  priority    String
  ownerId     String?   @map("owner_id")
  tags        String[]
  notes       String
  orderNum    Int       @map("order_num")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([workspaceId])
  @@map("swot_cards")
}

model Task {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       String    @default("todo")
  priority     String    @default("medium")
  dueDate      DateTime? @map("due_date")
  authorId     String?   @map("author_id")
  assignedToId String?   @map("assigned_to_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([workspaceId])
  @@map("tasks")
}

model Campaign {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  goal        String
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  priority    String
  status      String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  leads Lead[]

  @@index([workspaceId])
  @@map("campaigns")
}

model Lead {
  id         String     @id @default(uuid())
  campaignId String?    @map("campaign_id")
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  email      String
  planName   String     @map("plan_name")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([campaignId])
  @@map("leads")
}

// ============================================================
// INTEGRATIONS & MEDIA
// ============================================================

model FcmToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("fcm_tokens")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     Json
  body      Json
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  dedupeKey String?  @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Media {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cloudinaryId String    @map("cloudinary_id")
  url          String
  filename     String
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  width        Int?
  height       Int?
  altText      String    @map("alt_text")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([workspaceId])
  @@map("media")
}

// Uploads log — records both locally-stored documents and Cloudinary-hosted images.
// Each row belongs to a single user (e.g. profile avatar uploads have no workspace scope).
model MediaFile {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileType     String   @map("file_type") // image | pdf | docx | sheet
  mimeType     String   @map("mime_type")
  filename     String
  storedName   String?  @map("stored_name") // sanitized filename used on disk
  path         String? // local filesystem path (documents); null for Cloudinary images
  publicUrl    String   @map("public_url")
  cloudinaryId String?  @map("cloudinary_id") // Cloudinary public_id (images)
  size         Int      @default(0)
  purpose      String?  @default("document") // avatar | document | portfolio
  shareToken   String   @unique @default(cuid()) @map("share_token")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("media_files")
}

// ============================================================
// SUBSCRIPTIONS & BILLING
// ============================================================

model Plan {
  id                   String    @id @default(uuid())
  name                 String
  nameI18n             Json?     @map("name_i18n")
  priceEgp             Int       @map("price_egp")
  priceEgpAnnual       Int?      @map("price_egp_annual")
  durationDays         Int?      @map("duration_days")
  limits               Json?
  workspaceLimit       Int       @map("workspace_limit")
  postsPerMonth        Int       @map("posts_per_month")
  storageMb            Int       @map("storage_mb")
  isActive             Boolean   @default(true)   @map("is_active")
  trialDays            Int       @map("trial_days")
  sortOrder            Int       @map("sort_order")
  features             Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  subscriptions Subscription[]
  requests      SubscriptionRequest[]

  @@index([isActive])
  @@map("plans")
}

model Subscription {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId         String?   @map("workspace_id")
  workspace           Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  planId              String    @map("plan_id")
  plan                Plan      @relation(fields: [planId], references: [id])
  status              String
  startedAt           DateTime  @default(now()) @map("started_at")
  expiresAt           DateTime? @map("expires_at")
  canceledAt          DateTime? @map("canceled_at")
  trialStartedAt      DateTime? @map("trial_started_at")
  trialEndsAt         DateTime? @map("trial_ends_at")
  gracePeriodEndsAt   DateTime? @map("grace_period_ends_at")
  paymentProvider     String?   @map("payment_provider")
  paymentId           String?   @map("payment_id")
  amountEgp           Int?      @map("amount_egp")
  planSnapshot        Json?     @map("plan_snapshot")
  requestId           String?   @unique @map("request_id")
  createdBy           String?   @map("created_by")
  deletedAt           DateTime? @map("deleted_at")

  events   SubscriptionEvent[]
  payments Payment[]

  @@index([userId])
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionRequest {
  id        String    @id @default(uuid())
  code      String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String    @map("plan_id")
  plan      Plan      @relation(fields: [planId], references: [id])
  status    String    @default("PENDING")
  note      String?
  handledBy String?   @map("handled_by")
  handledAt DateTime? @map("handled_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("subscription_requests")
}

model SubscriptionEvent {
  id           String   @id @default(uuid())
  subscriptionId String  @map("subscription_id")
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType    String   @map("event_type")
  fromStatus   String?  @map("from_status")
  toStatus     String?  @map("to_status")
  fromPlanId   String?  @map("from_plan_id")
  toPlanId     String?  @map("to_plan_id")
  metadata     Json
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@map("subscription_events")
}

model Payment {
  id             String       @id @default(uuid())
  subscriptionId String?      @map("subscription_id")
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  orderId        String?      @map("order_id")
  amountEgp      Int          @map("amount_egp")
  currency       String
  status         String
  metadata       Json
  confirmedBy    String?   @map("confirmed_by")
  confirmedAt    DateTime? @map("confirmed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime?    @map("completed_at")

  @@index([subscriptionId])
  @@index([userId])
  @@map("payments")
}

// ============================================================
// SYSTEM & ADMIN
// ============================================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json?
  type        String
  description String?

  @@index([key])
  @@map("system_settings")
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  adminId       String?  @map("admin_id")
  admin         User?    @relation("AdminAuditAdmin", fields: [adminId], references: [id])
  action        String
  targetType    String   @map("target_type")
  targetId      String?  @map("target_id")
  targetUserId  String?  @map("target_user_id")
  targetUser    User?    @relation("AdminAuditTarget", fields: [targetUserId], references: [id])
  reason        String?
  metadata      Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([targetUserId])
  @@map("admin_audit_log")
}

model AdminUserNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation("AdminNoteOwner", fields: [userId], references: [id], onDelete: Cascade)
  adminId   String?  @map("admin_id")
  admin     User?    @relation("AdminNoteAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("admin_user_notes")
}

model Referral {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation("ReferralOwner", fields: [userId], references: [id], onDelete: Cascade)
  code        String   @unique
  referredBy  String?  @map("referred_by")
  referredByUser User? @relation("ReferralReferrer", fields: [referredBy], references: [id])
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  usedAt      DateTime? @map("used_at")

  @@index([userId])
  @@index([referredBy])
  @@map("referrals")
}

model SharedLink {
  id        String    @id @default(uuid())
  workspaceId String   @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug      String
  isActive  Boolean   @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("shared_links")
}

// ============================================================
// PORTFOLIO PROFILE
// ============================================================

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique
  displayName String?  @map("display_name")
  bio               String?
  avatarUrl         String?  @map("avatar_url")
  professionalTitle String?  @map("professional_title")
  location          String?  @map("location")
  skills            String[] @default([])
  experience        Json?
  education          Json?
  projects          Json?    @map("projects")
  contactLinks      Json?    @map("contact_links")
  appearance        Json?
  localized         Json?
  status            String   @default("DRAFT")
  adminHidden       Boolean  @default(false) @map("admin_hidden")
  adminHiddenReason String?  @map("admin_hidden_reason")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pages          ProfilePage[]
  projectPages   ProjectPage[]
  testimonials   Testimonial[]
  services       Service[]
  viewEvents     PortfolioViewEvent[]
  dailyVisits    DailyVisit[]

  @@map("user_profiles")
}

model ProfilePage {
  id          String        @id @default(uuid())
  profileId   String        @map("profile_id")
  profile     UserProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  pageOrder   Int           @default(0) @map("page_order")
  isPublished Boolean       @default(true) @map("is_published")
  sections    PageSection[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  @@unique([profileId, slug])
  @@index([profileId])
  @@map("profile_pages")
}

model PageSection {
  id            String      @id @default(uuid())
  pageId        String      @map("page_id")
  page          ProfilePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionType   String      @map("section_type")
  sectionOrder  Int         @default(0) @map("section_order")
  content       Json
  settings      Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  @@index([pageId])
  @@map("page_sections")
}

model ProjectPage {
  id              String      @id @default(uuid())
  profileId       String      @map("profile_id")
  profile         UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  description     String?
  coverImage      String?     @map("cover_image")
  projectUrl      String?     @map("project_url")
  externalLink    String?     @map("external_link")
  linkLabel       String?     @map("link_label")
  tags            String[]    @default([])
  gallery         String[]    @default([])
  content         Json?
  isPublished     Boolean     @default(true) @map("is_published")
  // Home-page card visibility. Pages created from the Pages tab are content
  // pages (false); cards created in the Projects section are true. This is
  // separate from `isPublished`, which controls the detail page itself.
  showInProjects  Boolean     @default(true) @map("show_in_projects")
  sortOrder       Int         @default(0) @map("sort_order")
  displayMode     String      @default("grid") @map("display_mode")
  showBackButton  Boolean     @default(true) @map("show_back_button")
  backButtonLabel String      @default("Back to Portfolio") @map("back_button_label")
  linkedFromProjectId String? @map("linked_from_project_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  items       ProjectItem[]

  @@unique([profileId, slug])
  @@index([profileId])
  @@map("project_pages")
}

model ProjectItem {
  id              String      @id @default(uuid())
  projectId       String      @map("project_id")
  project         ProjectPage @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            String      // workspace_strategy, workspace_content, workspace_media, external_link, external_text, external_image
  
  // The ID of the item if it's from the workspace
  workspaceItemId String?     @map("workspace_item_id")
  
  // External content fields
  externalUrl     String?     @map("external_url")
  textContent     String?     @map("text_content")
  imageUrl        String?     @map("image_url")
  title           String?     // Optional title for the item
  
  sortOrder       Int         @default(0) @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("project_items")
}

model Testimonial {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  author    String
  role      String?
  body      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("testimonials")
}

model Service {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("services")
}

model PortfolioViewEvent {
  id            String      @id @default(uuid())
  profileId     String      @map("profile_id")
  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  eventType     String      @map("event_type") // page_view | project_view | whatsapp_click
  projectPageId String?     @map("project_page_id")
  country       String?
  language      String?
  referrer      String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([profileId, createdAt])
  @@index([profileId, eventType, createdAt])
  @@map("portfolio_view_events")
}

model DailyVisit {
  id          String   @id @default(cuid())
  portfolioId String   @map("portfolio_id")
  profile     UserProfile @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  projectSlug String?  @map("project_slug")
  day         DateTime @db.Date
  count       Int      @default(0)

  @@unique([portfolioId, projectSlug, day])
  @@index([portfolioId, day])
  @@map("daily_visits")
}

model VisitDedup {
  key String   @id
  day DateTime @db.Date

  @@index([day])
  @@map("visit_dedups")
}

model Announcement {
  id             String    @id @default(uuid())
  title          String
  body           String
  type           String    @default("INFO") // INFO, WARNING, SUCCESS, MAINTENANCE
  active         Boolean   @default(true)
  targetAudience String    @default("ALL") @map("target_audience") // ALL, SUBSCRIBERS, FREE
  dismissible    Boolean   @default(true)
  startsAt       DateTime  @default(now()) @map("starts_at")
  expiresAt      DateTime? @map("expires_at")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([active, startsAt])
  @@map("announcements")
}

